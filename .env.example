# FoodWise Environment Configuration (Server-Side Only)

# [REQUIRED] MongoDB Connection String (Atlas or local instance)
MONGODB_URI=

# [REQUIRED for Foodie AI] Groq Cloud API Key (https://console.groq.com)
GROQ_API_KEY=

# [OPTIONAL] MongoDB Database Name (defaults to foodwise)
MONGODB_DB_NAME=foodwise

# [OPTIONAL] Groq Model identifier (defaults to openai/gpt-oss-20b or llama-3.3-70b-versatile)
GROQ_MODEL=

# [OPTIONAL] Web Push Notifications (run `npx web-push generate-vapid-keys` to generate)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
